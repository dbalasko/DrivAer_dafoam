// Refinement boxes for wake and other regions
objectRefinements
{
    Box2
    {
        type box;
        cellSize 0.4;
        centre (3 0 0);
        lengthX 10;
        lengthY 4;
        lengthZ 4;
    }
    // Wake region behind car
    Box1
    {
        type box;
        cellSize 0.2;
        centre (3 0 0);
        lengthX 8;
        lengthY 2.5;
        lengthZ 2.5;
    }
    wakeBox
    {
        type box;
        cellSize 0.1;
        centre (3 0 0);
        lengthX 5;
        lengthY 2;
        lengthZ 2;
    }
