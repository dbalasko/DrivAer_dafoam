// Rename boundary patches for the bounding box
renameBoundary
{
    newPatchNames
    {
        "xMin"
        {
            newName inlet;
            type    patch;
        }

        "xMax"
        {
            newName outlet;
            type    patch;
        }

        "zMin"
        {
            newName symmetry;
            type    symmetry;  // or wall
        }

        "zMax"
        {
            newName symmetry;
            type    symmetry;  // or wall
        }

        "yMin"
        {
            newName wall;
            type    wall;
        }

        "yMax"
        {
            newName symmetry;
            type    symmetry;
        }
    }
}

