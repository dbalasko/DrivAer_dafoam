FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
    version	2.0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    wall
    {
        type            zeroGradient;
    }

    "(body|fastback|frontIntakes|lightsFront|mirrorStripe|mirrors|underbody|windowsFront|windowsRear)"
    {
        type            zeroGradient;
    }
    
    optSurface
    {
        type            zeroGradient;
    }
    
    "(tyresFront|wheelsFront)"
    {
    	type		zeroGradient;
    }
        
    "(tyresRear|wheelsRear)"
    {
    	type		zeroGradient;
    }
    
    symmetry
    {
    	type 		symmetry;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

