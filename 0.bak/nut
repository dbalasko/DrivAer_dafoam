FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nut;
    version	2.0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-05;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 1e-05;
    }

    outlet
    {
        type            zeroGradient;
    }

    wall
    {
        type            nutUSpaldingWallFunction;
        value           uniform 1e-05;
    }
    
    "(body|fastback|frontIntakes|lightsFront|mirrorStripe|mirrors|underbody|windowsFront|windowsRear)"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 1e-05;
    }
    
    optSurface
    {
        type            nutUSpaldingWallFunction;
        value           uniform 1e-05;
    }
    
    "(tyresFront|wheelsFront)"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 1e-05;
    }
    
    "(tyresRear|wheelsRear)"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 1e-05;
    }
    
    symmetry
    {
    	type 		symmetry;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

