FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
    version	2.0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Uinlet          (20 0 0);

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $Uinlet;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    wall
    {
        type            noSlip;
    }
    
    "(body|fastback|frontIntakes|lightsFront|mirrorStripe|mirrors|underbody|windowsFront|windowsRear)"
    {
    	type		noSlip;
    }
    
    optSurface
    {
    	type		noSlip;
    }
    
    "(tyresFront|wheelsFront)"
    {
	type		rotatingWallVelocity;
	origin		(0 0 1.410);
	axis		(0 0 1);
	omega 		62.79;
    } 
    
    "(tyresRear|wheelsRear)"
    {
	type		rotatingWallVelocity;
	origin		(2.786 0 1.410);
	axis		(0 0 1);
	omega 		62.79;
    }
       
    symmetry
    {
    	type 		symmetry;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}

